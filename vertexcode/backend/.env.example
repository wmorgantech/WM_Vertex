# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vertexwm?schema=public"

# Server
PORT=5111
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5174

# SMTP (email) — generic SMTP config so the provider (Gmail, Brevo, etc.) can be
# swapped by editing these values only; no code change required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VertexWM
SMTP_FROM_EMAIL=no-reply@vertexwm.com

# Public app URL — used to build links in emails/PDFs (offer letter / certificate)
APP_URL=http://localhost:5174
