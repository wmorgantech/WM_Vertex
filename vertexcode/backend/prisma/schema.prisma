generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id           String        @id @default(uuid())
  name         String        @unique
  description  String?
  headId       String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  head         User?         @relation("DepartmentHead", fields: [headId], references: [id])
  designations Designation[]
  users        User[]        @relation("DepartmentMembers")
}

model EmploymentType {
  code      String   @id
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Designation {
  id           String      @id @default(uuid())
  name         String      @unique
  departmentId String?
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id])
  timesheets   Timesheet[] @relation("TimesheetPosition")
  users        User[]      @relation("UserDesignation")
}

model Location {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  city      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model CollegeType {
  code      String    @id
  label     String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  colleges  College[]
}

model TaskType {
  code      String   @id
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model TaskPriority {
  code      String   @id
  label     String
  color     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model TaskStatus {
  code      String   @id
  label     String
  color     String?
  isFinal   Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model TimesheetStatus {
  code       String      @id
  label      String
  color      String?
  isFinal    Boolean     @default(false)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  timesheets Timesheet[]
}

model LeaveType {
  code      String         @id
  label     String
  paid      Boolean        @default(true)
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  requests  LeaveRequest[]
}

model LeaveRequest {
  id              String             @id @default(uuid())
  userId          String
  leaveTypeCode   String
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  approverId      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  approver        User?              @relation("LeaveApprover", fields: [approverId], references: [id])
  leaveType       LeaveType          @relation(fields: [leaveTypeCode], references: [code])
  user            User               @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model CustomFieldDefinition {
  id         String                @id @default(uuid())
  entityType CustomFieldEntityType
  name       String
  fieldType  CustomFieldType
  options    String[]              @default([])
  required   Boolean               @default(false)
  active     Boolean               @default(true)
  sortOrder  Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  values     CustomFieldValue[]

  @@unique([entityType, name])
}

model CustomFieldValue {
  id        String                @id @default(uuid())
  fieldId   String
  entityId  String
  value     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, entityId])
  @@index([entityId])
}

model ExpenseCategory {
  code      String    @id
  label     String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Expense {
  id           String           @id @default(uuid())
  categoryCode String
  title        String
  description  String?
  amount       Float
  expenseDate  DateTime         @db.Date
  paymentMode  String?
  reference    String?
  vendor       String?
  linkType     ExpenseLinkType?
  linkId       String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     ExpenseCategory  @relation(fields: [categoryCode], references: [code])
  recordedBy   User             @relation("ExpenseRecorder", fields: [recordedById], references: [id])

  @@index([categoryCode])
  @@index([expenseDate])
  @@index([linkType, linkId])
}

model Permission {
  id        String   @id @default(uuid())
  role      Role
  module    String
  action    String
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, module, action])
}

model AppSettings {
  id             Int      @id @default(1)
  companyName    String?
  companyAddress String?
  companyLogoUrl String?
  signatoryName  String?
  signatoryTitle String?
  updatedAt      DateTime @updatedAt
}

model NotificationSetting {
  type      NotificationType @id
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  module      String
  entityId    String
  entityLabel String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([module])
  @@index([entityId])
  @@index([createdAt])
}

model User {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?
  role                     Role                    @default(EMPLOYEE)
  designation              String?
  status                   EmploymentStatus        @default(ACTIVE)
  joinDate                 DateTime                @default(now())
  exitDate                 DateTime?
  mustChangePassword       Boolean                 @default(false)
  avatarUrl                String?
  departmentId             String?
  managerId                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  locationId               String?
  employmentType           String                  @default("FULL_TIME")
  address                  String?
  certifications           String[]                @default([])
  dateOfBirth              DateTime?
  experienceYears          Float?
  gender                   String?
  skills                   String[]                @default([])
  technologyStack          String[]                @default([])
  attendances              Attendance[]
  auditLogs                AuditLog[]              @relation("AuditActor")
  generatedCertificates    CompletionCertificate[] @relation("CertificateGenerator")
  reviewedWorkUpdates      DailyWorkUpdate[]       @relation("WorkUpdateReviewer")
  workUpdates              DailyWorkUpdate[]       @relation("WorkUpdateOwner")
  departmentHeadOf         Department?             @relation("DepartmentHead")
  recordedExpenses         Expense[]               @relation("ExpenseRecorder")
  reviewedDocuments        InternDocument[]        @relation("DocumentReviewer")
  documentAuditActions     InternDocumentAudit[]   @relation("DocumentAuditActor")
  finalApprovedEnrollments InternEnrollment[]      @relation("EnrollmentFinalApprover")
  mentoredInterns          InternEnrollment[]      @relation("InternMentor")
  internEnrollment         InternEnrollment?
  internshipAuditActions   InternshipAudit[]
  approvedLeaveRequests    LeaveRequest[]          @relation("LeaveApprover")
  leaveRequests            LeaveRequest[]          @relation("LeaveOwner")
  assignedMous             MOU[]                   @relation("MouAssignee")
  assignedEnquiries        Enquiry[]               @relation("EnquiryAssignee")
  notifications            Notification[]
  generatedOfferLetters    OfferLetter[]           @relation("OfferLetterGenerator")
  managedProjects          Project[]               @relation("ProjectManager")
  projectMembers           ProjectMember[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  assignedTasks            Task[]                  @relation("TaskAssignee")
  createdTasks             Task[]                  @relation("TaskCreator")
  approvedTimesheets       Timesheet[]             @relation("TimesheetApprover")
  timesheets               Timesheet[]             @relation("TimesheetOwner")
  mentoredTrainees         TraineeEnrollment[]     @relation("TraineeMentor")
  traineeEnrollment        TraineeEnrollment?
  recordedTraineePayments  TraineePayment[]        @relation("PaymentRecorder")
  mentorOfPrograms         TrainingProgram[]       @relation("ProgramMentor")
  trainerOfPrograms        TrainingProgram[]       @relation("ProgramTrainer")
  mentorOfSessions         TrainingSession[]       @relation("SessionMentor")
  trainerOfSessions        TrainingSession[]       @relation("SessionTrainer")
  department               Department?             @relation("DepartmentMembers", fields: [departmentId], references: [id])
  designationRef           Designation?            @relation("UserDesignation", fields: [designation], references: [name])
  employmentTypeRef        EmploymentType          @relation(fields: [employmentType], references: [code])
  location                 Location?               @relation(fields: [locationId], references: [id])
  manager                  User?                   @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports            User[]                  @relation("ManagerHierarchy")
  assignedWorkshops        Workshop[]              @relation("WorkshopAssignee")
  trainerOfWorkshops       Workshop[]              @relation("WorkshopTrainer")

  @@index([role])
  @@index([departmentId])
  @@index([managerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Only a SHA-256 hash of the raw token is ever stored (the raw, single-use
// token is emailed to the user and never persisted) — unlike RefreshToken
// above, which intentionally stores the verifiable JWT itself since that
// token is meant to be looked up/revoked by its own value, not compared
// against user-submitted input the way a password-reset token is.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InternshipBatch {
  id          String             @id @default(uuid())
  name        String
  program     String
  startDate   DateTime
  endDate     DateTime
  status      InternBatchStatus  @default(UPCOMING)
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments InternEnrollment[]
}

model InternEnrollment {
  id                  String                 @id @default(uuid())
  userId              String                 @unique
  batchId             String
  mentorId            String?
  completionStatus    InternCompletionStatus @default(IN_PROGRESS)
  performanceRating   Float?
  progressPercent     Int                    @default(0)
  stipend             Float?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  branch              String?
  collegeDepartment   String?
  collegeEmail        String?
  collegeName         String?
  course              String?
  hodName             String?
  internshipEndDate   DateTime?
  internshipStartDate DateTime?
  registerNumber      String?
  semester            Int?
  university          String?
  year                Int?
  category            InternshipCategory?
  finalApprovedAt     DateTime?
  finalApprovedById   String?
  certificate         CompletionCertificate?
  documents           InternDocument[]
  batch               InternshipBatch        @relation(fields: [batchId], references: [id])
  finalApprovedBy     User?                  @relation("EnrollmentFinalApprover", fields: [finalApprovedById], references: [id])
  mentor              User?                  @relation("InternMentor", fields: [mentorId], references: [id])
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs           InternshipAudit[]
  offerLetter         OfferLetter?
}

model InternDocument {
  id           String                @id @default(uuid())
  enrollmentId String
  type         InternDocumentType
  fileName     String
  filePath     String
  mimeType     String
  fileSize     Int
  status       InternDocumentStatus  @default(DRAFT)
  adminRemarks String?
  reviewedById String?
  reviewedAt   DateTime?
  uploadedAt   DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  enrollment   InternEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  reviewedBy   User?                 @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  auditLogs    InternDocumentAudit[]

  @@index([enrollmentId])
  @@index([status])
}

model InternDocumentAudit {
  id         String              @id @default(uuid())
  documentId String
  action     DocumentAuditAction
  actorId    String
  remarks    String?
  createdAt  DateTime            @default(now())
  actor      User                @relation("DocumentAuditActor", fields: [actorId], references: [id])
  document   InternDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model OfferLetter {
  id            String           @id @default(uuid())
  enrollmentId  String           @unique
  filePath      String
  fileName      String
  generatedById String
  generatedAt   DateTime         @default(now())
  enrollment    InternEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  generatedBy   User             @relation("OfferLetterGenerator", fields: [generatedById], references: [id])
}

model CompletionCertificate {
  id            String           @id @default(uuid())
  enrollmentId  String           @unique
  filePath      String
  fileName      String
  generatedById String
  generatedAt   DateTime         @default(now())
  enrollment    InternEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  generatedBy   User             @relation("CertificateGenerator", fields: [generatedById], references: [id])
}

model InternshipAudit {
  id           String                @id @default(uuid())
  enrollmentId String
  action       InternshipAuditAction
  actorId      String
  metadata     String?
  createdAt    DateTime              @default(now())
  actor        User                  @relation(fields: [actorId], references: [id])
  enrollment   InternEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([createdAt])
}

model TrainingProgram {
  id            String                @id @default(uuid())
  name          String
  description   String?
  technology    String?
  duration      String?
  totalSessions Int?
  trainerId     String
  mentorId      String?
  fee           Float?
  discount      Float?
  finalFee      Float?
  startDate     DateTime
  endDate       DateTime
  status        TrainingProgramStatus @default(UPCOMING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  enrollments   TraineeEnrollment[]
  mentor        User?                 @relation("ProgramMentor", fields: [mentorId], references: [id])
  trainer       User                  @relation("ProgramTrainer", fields: [trainerId], references: [id])
  sessions      TrainingSession[]
  topics        TrainingTopic[]
}

model TrainingTopic {
  id                    String                 @id @default(uuid())
  programId             String
  topic                 String
  description           String?
  sequence              Int                    @default(0)
  expectedDurationHours Float?
  trainingMaterial      String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  progress              TraineeTopicProgress[]
  sessions              TrainingSession[]
  program               TrainingProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model TraineeEnrollment {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  programId         String
  mentorId          String?
  completionStatus  InternCompletionStatus @default(IN_PROGRESS)
  progressPercent   Int                    @default(0)
  education         String?
  qualification     String?
  experienceYears   Float?
  trainingStartDate DateTime?
  trainingEndDate   DateTime?
  totalFee          Float?
  discount          Float?
  finalFee          Float?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  mentor            User?                  @relation("TraineeMentor", fields: [mentorId], references: [id])
  program           TrainingProgram        @relation(fields: [programId], references: [id])
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          TraineePayment[]
  topicProgress     TraineeTopicProgress[]
}

model TraineeTopicProgress {
  id               String              @id @default(uuid())
  enrollmentId     String
  topicId          String
  status           TopicProgressStatus @default(NOT_STARTED)
  assignmentStatus AssignmentStatus    @default(NOT_SUBMITTED)
  remarks          String?
  completedAt      DateTime?
  updatedAt        DateTime            @updatedAt
  enrollment       TraineeEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  topic            TrainingTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, topicId])
}

model TrainingSession {
  id               String          @id @default(uuid())
  programId        String
  topicId          String?
  trainerId        String
  mentorId         String?
  date             DateTime        @db.Date
  startTime        DateTime?
  endTime          DateTime?
  topicsCovered    String?
  topicsPending    String?
  trainingMaterial String?
  remarks          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mentor           User?           @relation("SessionMentor", fields: [mentorId], references: [id])
  program          TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  topic            TrainingTopic?  @relation(fields: [topicId], references: [id])
  trainer          User            @relation("SessionTrainer", fields: [trainerId], references: [id])

  @@index([programId, date])
}

model TraineePayment {
  id           String            @id @default(uuid())
  enrollmentId String
  amount       Float
  paymentDate  DateTime          @default(now())
  paymentMode  String?
  reference    String?
  notes        String?
  recordedById String
  createdAt    DateTime          @default(now())
  enrollment   TraineeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy   User              @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([enrollmentId])
}

model College {
  id            String              @id @default(uuid())
  name          String              @unique
  typeCode      String?
  university    String?
  address       String?
  city          String?
  district      String?
  state         String?
  website       String?
  contactPerson String?
  phone         String?
  email         String?
  coordinator   String?
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  type          CollegeType?        @relation(fields: [typeCode], references: [code])
  departments   CollegeDepartment[]
  mous          MOU[]
  workshops     Workshop[]
}

model CollegeDepartment {
  id            String     @id @default(uuid())
  collegeId     String
  name          String
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  college       College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  mous          MOU[]
  workshops     Workshop[]

  @@unique([collegeId, name])
}

model Workshop {
  id                   String             @id @default(uuid())
  collegeId            String
  collegeDepartmentId  String?
  contactPerson        String?
  contactNumber        String?
  contactEmail         String?
  topic                String
  technology           String?
  proposedDate         DateTime?
  confirmedDate        DateTime?
  duration             String?
  expectedParticipants Int?
  actualParticipants   Int?
  assignedEmployeeId   String?
  trainerId            String?
  status               WorkshopStatus     @default(LEAD)
  followUpDate         DateTime?
  discussionNotes      String?
  nextAction           String?
  remarks              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  assignedEmployee     User?              @relation("WorkshopAssignee", fields: [assignedEmployeeId], references: [id])
  collegeDepartment    CollegeDepartment? @relation(fields: [collegeDepartmentId], references: [id])
  college              College            @relation(fields: [collegeId], references: [id])
  trainer              User?              @relation("WorkshopTrainer", fields: [trainerId], references: [id])

  @@index([collegeId])
  @@index([status])
}

model MOU {
  id                  String             @id @default(uuid())
  collegeId           String
  collegeDepartmentId String?
  contactPerson       String?
  mouType             String?
  purpose             String?
  startDate           DateTime?
  endDate             DateTime?
  status              MouStatus          @default(DISCUSSION)
  assignedEmployeeId  String?
  signedDate          DateTime?
  renewalDate         DateTime?
  documentPath        String?
  documentName        String?
  remarks             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  assignedEmployee    User?              @relation("MouAssignee", fields: [assignedEmployeeId], references: [id])
  collegeDepartment   CollegeDepartment? @relation(fields: [collegeDepartmentId], references: [id])
  college             College            @relation(fields: [collegeId], references: [id])

  @@index([collegeId])
  @@index([status])
}

model Enquiry {
  id                 String        @id @default(uuid())
  contactName        String
  contactEmail       String?
  contactPhone       String?
  companyName        String?
  subject            String
  description        String?
  source             EnquirySource @default(WEBSITE)
  // Internal enquiry topic (HR/Payroll/Leave/Attendance/Task/IT Support/...),
  // separate from `source` (external lead attribution channel — unchanged).
  // Plain string, not an enum: the allowed set differs by role and is
  // validated in enquiry.controller.js rather than at the DB level, the same
  // way status transitions are already handled there.
  category           String?
  assignedEmployeeId String?
  status             EnquiryStatus @default(NEW)
  followUpDate       DateTime?
  nextAction         String?
  remarks            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  assignedEmployee   User?         @relation("EnquiryAssignee", fields: [assignedEmployeeId], references: [id])

  @@index([status])
  @@index([assignedEmployeeId])
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus   @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  manager     User            @relation("ProjectManager", fields: [managerId], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  timesheets  Timesheet[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        String       @default("DAILY")
  priority    String       @default("MEDIUM")
  status      String       @default("TODO")
  progress    Int          @default(0)
  dueDate     DateTime?
  projectId   String?
  assigneeId  String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  priorityRef TaskPriority @relation(fields: [priority], references: [code])
  project     Project?     @relation(fields: [projectId], references: [id])
  statusRef   TaskStatus   @relation(fields: [status], references: [code])
  typeRef     TaskType     @relation(fields: [type], references: [code])
  timesheets  Timesheet[]

  @@index([assigneeId])
  @@index([status])
  @@index([projectId])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  date      DateTime         @db.Date
  clockIn   DateTime?
  clockOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  workHours Float?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model Timesheet {
  id              String          @id @default(uuid())
  userId          String
  date            DateTime        @db.Date
  projectId       String?
  taskId          String?
  hoursLogged     Float
  description     String?
  status          String          @default("PENDING")
  approverId      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  position        String?
  approver        User?           @relation("TimesheetApprover", fields: [approverId], references: [id])
  positionRef     Designation?    @relation("TimesheetPosition", fields: [position], references: [name])
  project         Project?        @relation(fields: [projectId], references: [id])
  statusRef       TimesheetStatus @relation(fields: [status], references: [code])
  task            Task?           @relation(fields: [taskId], references: [id])
  user            User            @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([status])
}

model DailyWorkUpdate {
  id              String           @id @default(uuid())
  userId          String
  date            DateTime         @db.Date
  summary         String
  tasksCompleted  String?
  blockers        String?
  planForTomorrow String?
  status          WorkUpdateStatus @default(SUBMITTED)
  managerFeedback String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  reviewedBy      User?            @relation("WorkUpdateReviewer", fields: [reviewedById], references: [id])
  user            User             @relation("WorkUpdateOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

