# =========================================================
# VertexWM - root .gitignore
# Single root ignore file covering:
#   vertexcode/frontend  (Vite + React)
#   vertexcode/backend   (Node/Express + Prisma)
#   vertexcode/App       (currently empty - generic JS rules only)
# =========================================================

# --- Dependencies ---
node_modules/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Build output ---
dist/
build/

# --- Test / coverage ---
coverage/

# --- Vite ---
.vite/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Caches ---
.cache/
.eslintcache

# --- Backend: Prisma / uploads ---
# Prisma schema and migrations ARE tracked on purpose - do not ignore prisma/
backend/uploads/
*.sqlite
*.sqlite3

# --- OS ---
.DS_Store
Thumbs.db

# --- App/ (React Native / Expo) ---
# App/ is currently empty, so its tech stack can't be confirmed yet.
# Once it's scaffolded, uncomment the block that matches (Expo shown as the
# common default - adjust if App/ turns out to be plain React Native/other).
# .expo/
# .expo-shared/
# *.jks
# *.p12
# *.key
# *.mobileprovision
# ios/Pods/
# android/.gradle/
# android/app/build/

# --- Local scratch/probe artifacts (not part of the app) ---
/_probe/
/synctest/
/vertexcode/_bashtest/
/vertexcode/backend/probe.txt
